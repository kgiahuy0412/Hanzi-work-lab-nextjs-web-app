{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himi.local/schemas/hsk3-textbook-lesson.schema.json",
  "title": "HSK 3 textbook lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "lessonNumber",
    "status",
    "title",
    "source",
    "sections",
    "editorial"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^hsk3-tb-lesson-[0-9]{2}$"
    },
    "lessonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published"
      ]
    },
    "title": {
      "type": "object",
      "required": [
        "zh",
        "pinyin",
        "vi"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "pdfPages",
        "printedPages",
        "sourcePageRefs"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 8
    },
    "editorial": {
      "type": "object"
    }
  }
}
