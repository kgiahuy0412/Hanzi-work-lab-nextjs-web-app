      "description": "Ví dụ tách sự kiện học khỏi dữ liệu nội dung"
    }
  ],
  "lessonProfiles": {
    "hsk-foundation": {
      "requiredSections": [
        "introduction",
        "vocabulary",
        "grammar",
        "dialogue",
        "pronunciation",
        "writing",
        "practice",
        "flashcard",
        "completion"
      ]
    },
    "industry-workplace": {
      "requiredSections": [
        "introduction",
        "scenario-video",
        "vocabulary",
        "dialogue",
        "usage-notes",
        "listening",
