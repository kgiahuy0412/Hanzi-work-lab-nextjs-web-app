{
  "schemaVersion": "1.0.0",
  "bundleId": "himi-lesson-json-samples-v1",
  "title": "Bộ dữ liệu JSON mẫu cho toàn bộ trải nghiệm học Himi Chinese",
  "description": "Dữ liệu mẫu tách kho nội dung chuẩn khỏi cấu trúc bài học và hoạt động luyện tập. Các file này chưa được nối vào runtime hiện tại.",
  "locale": {
    "interface": "vi-VN",
    "learning": "zh-CN",
    "pinyinSystem": "hanyu-pinyin-diacritic"
  },
  "referenceConvention": {
    "format": "{entity-type}:{stable-id}",
    "examples": [
      "lexeme:lex-ni-hao",
      "sentence:sentence-first-greeting",
      "media:media-video-work-progress"
    ]
  },
  "files": [
    {
      "path": "schemas/lesson.schema.json",
      "kind": "schema",
      "description": "JSON Schema tối thiểu cho file bài học"
    },
    {
      "path": "shared/lexemes.json",
      "kind": "shared-content",
      "entity": "lexeme"
    },
    {
      "path": "shared/characters.json",
      "kind": "shared-content",
      "entity": "character"
    },
    {
      "path": "shared/sentences.json",
