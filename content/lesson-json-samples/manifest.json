  "publicationRules": [
    "Mọi ID phải ổn định và duy nhất trong loại entity của nó.",
    "Mọi reference phải trỏ tới entity tồn tại.",
    "Nội dung tiếng Trung xuất bản phải có pinyin và bản dịch Việt, trừ khi activity chủ ý ẩn chúng.",
    "Audio chỉ được gửi cho người học khi reviewStatus là approved.",
    "Bài tập phải có đáp án hợp lệ và các phương án không trùng nhau.",
    "Mọi bài xuất bản phải có ít nhất một objective và một completionRule.",
    "Nội dung VIP phải được lọc ở server trước khi tạo delivery document."
  ]
}
