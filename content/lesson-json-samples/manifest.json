      "entity": "sentence"
    },
    {
      "path": "shared/grammar-points.json",
      "kind": "shared-content",
      "entity": "grammar-point"
    },
    {
      "path": "shared/dialogues.json",
      "kind": "shared-content",
      "entity": "dialogue"
    },
    {
      "path": "shared/media-assets.json",
      "kind": "shared-content",
      "entity": "media"
    },
    {
      "path": "shared/assessment-items.json",
      "kind": "shared-content",
      "entity": "assessment-item"
    },
    {
      "path": "shared/flashcard-templates.json",
      "kind": "shared-content",
      "entity": "flashcard-template"
    },
    {
      "path": "lessons/hsk-1-lam-quen-lan-dau.json",
