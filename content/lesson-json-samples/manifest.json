    },
    {
      "path": "lessons/van-phong-bao-tien-do.json",
      "kind": "lesson",
      "profile": "industry-workplace"
    },
    {
      "path": "lessons/on-tap-giao-tiep-cong-viec.json",
      "kind": "lesson",
      "profile": "review"
    },
    {
      "path": "activities/listening-lesson.json",
      "kind": "activity",
      "profile": "listening"
    },
    {
      "path": "activities/writing-lesson.json",
      "kind": "activity",
      "profile": "writing"
    },
    {
      "path": "activities/video-lesson.json",
      "kind": "activity",
