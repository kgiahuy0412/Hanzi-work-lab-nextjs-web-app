{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himi.local/schemas/lesson.schema.json",
  "title": "Himi lesson composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "profile",
    "status",
    "metadata",
    "access",
    "objectives",
    "sections",
    "completionRule",
    "editorial"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile": {
      "enum": [
        "hsk-foundation",
        "industry-workplace",
        "review"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "titleVi",
        "summaryVi",
        "estimatedMinutes",
        "skills"
      ],
      "properties": {
        "titleVi": {
          "type": "string",
          "minLength": 1
        },
        "summaryVi": {
          "type": "string",
          "minLength": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "listening",
              "speaking",
              "reading",
              "writing",
              "translation",
              "workplace-response"
            ]
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "enum": [
            "free",
            "vip"
          ]
        },
        "previewSectionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill",
          "descriptionVi"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stableId"
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "descriptionVi": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "completionRule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "required-sections",
            "minimum-score",
            "combined"
          ]
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contentVersion",
        "languageReviewStatus",
        "updatedAt"
      ],
      "properties": {
        "contentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "languageReviewStatus": {
          "enum": [
            "pending",
            "approved",
            "changes-requested"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z-]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "titleVi",
        "required",
        "estimatedMinutes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "introduction",
            "scenario-video",
            "vocabulary",
            "grammar",
            "usage-notes",
            "dialogue",
            "listening",
            "pronunciation",
            "writing",
            "practice",
            "flashcard",
            "review-queue",
            "completion"
          ]
        },
        "titleVi": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "itemRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  }
}
