.game-next-button {
  min-width: 172px;
  margin: 22px auto 0;
  display: flex;
  background: #08786d;
}
.game-next-button:disabled {
  cursor: default;
  color: #82928d;
  background: #e5ebe8;
}
.write-prompt {
  padding: 60px 20px 25px;
  text-align: center;
}
.write-prompt h2 {
  margin: 12px 0 5px;
  color: #143e37;
  font-size: clamp(40px, 5vw, 60px);
  letter-spacing: -.045em;
}
.write-prompt p {
  margin: 0;
  color: #74847f;
  font-size: 10px;
}
.write-prompt p b {
  color: #9ca8a4;
  letter-spacing: .12em;
}
.write-answer-form {
  max-width: 720px;
  margin: 18px auto 0;
