}
.hsk-guided-dialogue-list article > span {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  color: #fff;
  border-radius: 50%;
  background: var(--guided-green-deep);
  font-size: 12px;
  font-weight: 780;
}
.hsk-guided-dialogue-list article > div {
  display: grid;
  gap: 3px;
}
.hsk-guided-dialogue-list small {
  color: #75837f;
  font-size: 9px;
  font-weight: 760;
}
.hsk-guided-dialogue-list strong {
  font-size: 16px;
}
.hsk-guided-dialogue-list b {
  color: var(--guided-green-deep);
  font-size: 10px;
}
.hsk-guided-dialogue-list p {
  margin: 0;
  color: #6c7d78;
  font-size: 10px;
}
.hsk-guided-writing {
  max-width: 860px;
  margin: 0 auto;
}
.hsk-guided-writing h1 {
  margin-top: 13px;
}
.hsk-guided-writing-picker {
  margin-top: 18px;
  padding: 5px 2px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  overflow: visible;
}
.hsk-guided-writing-picker button {
  min-width: 62px;
  min-height: 61px;
  padding: 5px;
  flex: 0 0 62px;
  display: grid;
  place-items: center;
  cursor: pointer;
  color: #60726d;
  border: 1px solid #dce7e4;
  border-radius: 13px;
  background: #fff;
}
.hsk-guided-writing-picker button span {
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 24px;
}
.hsk-guided-writing-picker button small {
  font-size: 8px;
}
.hsk-guided-writing-picker button[aria-pressed="true"] {
  color: #fff;
  border-color: var(--guided-green);
  background: var(--guided-green);
}
.hsk-guided-writing-layout {
  margin-top: 16px;
  display: grid;
  grid-template-columns: minmax(380px, 1fr) 220px;
  gap: 18px;
}
.hsk-guided-writing-layout > div {
  padding: 20px;
  display: grid;
  justify-items: center;
}
.hsk-guided-writing-modes {
  margin-bottom: 14px;
  padding: 4px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  border-radius: 13px;
  background: #f1f4f3;
}
.hsk-guided-writing-modes button {
  min-height: 35px;
  padding: 0 16px;
  cursor: pointer;
  color: #63736f;
  border: 0;
  border-radius: 10px;
  background: transparent;
  font-size: 10px;
  font-weight: 720;
}
.hsk-guided-writing-modes button[aria-pressed="true"] {
  color: #fff;
  background: var(--guided-green);
}
.hsk-guided-writing-board {
  position: relative;
  width: min(360px, 100%);
  aspect-ratio: 1;
  overflow: hidden;
  border: 1px solid #dce7e4;
  border-radius: 20px;
  background: #fff;
}
.hsk-guided-writing-board > div {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
}
.hsk-guided-writing-board > span {
  position: absolute;
  z-index: 1;
  background: #e2eae8;
}
.hsk-guided-writing-board > span:first-child {
  top: 50%;
  left: 0;
  width: 100%;
  height: 1px;
}
.hsk-guided-writing-board > span:nth-child(2) {
  top: 0;
  left: 50%;
  width: 1px;
  height: 100%;
}
.hsk-guided-writing-layout > div > p {
  min-height: 24px;
  margin: 11px 0 0;
  color: #657671;
  font-size: 10px;
}
.hsk-guided-writing-layout > aside {
  padding: 24px;
  display: grid;
  justify-items: center;
  align-content: center;
  text-align: center;
}
.hsk-guided-writing-layout > aside > strong {
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 80px;
  line-height: 1;
}
.hsk-guided-writing-layout > aside > div {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.hsk-guided-writing-layout > aside b {
  color: var(--guided-green-deep);
  font-size: 17px;
}
.hsk-guided-writing-layout > aside > p {
  margin: 8px 0 20px;
  color: #687a75;
  font-size: 12px;
}
.hsk-guided-writing-layout > aside > button {
  min-height: 38px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  cursor: pointer;
  color: var(--guided-green-deep);
  border: 1px solid #c8e2db;
  border-radius: 11px;
  background: #fff;
  font-size: 10px;
  font-weight: 720;
}
.hsk-guided-practice {
  max-width: 700px;
  margin: 0 auto;
  padding: 34px;
  text-align: center;
}
.hsk-guided-practice h1 {
  margin-top: 12px;
  font-size: 31px;
}
.hsk-guided-practice-prompt {
  min-height: 120px;
  display: grid;
  place-items: center;
  font-family: Georgia, "Noto Serif SC", serif;
  font-size: 76px;
}
.hsk-guided-practice-prompt.has-pinyin {
  font-size: clamp(27px, 4vw, 46px);
  line-height: 1.45;
  text-align: center;
}
.hsk-guided-listen {
  width: 94px;
  height: 94px;
  margin: 28px auto;
  display: grid;
  place-items: center;
  cursor: pointer;
  color: #fff;
  border: 0;
  border-radius: 50%;
  background: var(--guided-green);
  box-shadow: 0 7px 0 var(--guided-green-deep);
}
.hsk-guided-listen span {
  font-size: 9px;
  font-weight: 740;
}
.hsk-guided-practice-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.hsk-guided-practice-options button {
  min-height: 58px;
  padding: 10px 14px;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  color: #3f5651;
  border: 1px solid #dce5e2;
  border-radius: 14px;
  background: #fff;
  text-align: left;
}
.hsk-guided-practice-options button b {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #eef3f1;
  font-size: 10px;
}
.hsk-guided-practice-options button span {
  font-size: 12px;
  font-weight: 680;
}
.hsk-guided-practice-options button.is-correct {
  color: #08705b;
  border-color: #83d2bd;
  background: #eafaf4;
}
.hsk-guided-practice-options button.is-wrong {
  color: #a44b45;
  border-color: #efb8b2;
  background: #fff2f0;
}
.hsk-guided-practice-options button.is-selected {
  color: var(--guided-green-deep);
  border-color: #ff9f8d;
  background: #fff4f1;
}
.hsk-guided-practice-feedback {
  margin: 15px 0 0;
  padding: 12px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 700;
}
.hsk-guided-practice-feedback.is-correct {
  color: #08705b;
  background: #eafaf4;
}
.hsk-guided-practice-feedback.is-wrong {
  color: #a44b45;
  background: #fff2f0;
}
.hsk-guided-practice-note {
  margin: 15px 0 0 !important;
  padding: 12px;
  color: #6e7f7a !important;
  border-radius: 12px;
  background: #f2f6f4;
  font-size: 11px !important;
}
.hsk-guided-completion {
  max-width: 720px;
  margin: 20px auto 0;
  display: grid;
  justify-items: center;
  text-align: center;
}
.hsk-guided-completion > span {
  width: 82px;
  height: 82px;
  display: grid;
  place-items: center;
  color: #fff;
  border-radius: 50%;
  background: var(--guided-green);
  box-shadow: 0 7px 0 var(--guided-green-deep);
}
.hsk-guided-completion > small {
  margin-top: 25px;
  color: var(--guided-green-deep);
  font-size: 10px;
  font-weight: 820;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.hsk-guided-completion h1 {
  margin-top: 8px;
}
.hsk-guided-completion > p {
  margin: 0;
  color: var(--guided-muted);
  font-size: 13px;
}
.hsk-guided-completion > div {
  width: 100%;
  margin-top: 28px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.hsk-guided-completion article {
  min-height: 92px;
  display: grid;
  place-items: center;
  align-content: center;
  border: 1px solid var(--guided-line);
  border-radius: 18px;
  background: #fff;
}
.hsk-guided-completion article strong {
  color: var(--guided-green-deep);
  font-size: 24px;
}
.hsk-guided-completion article span {
  color: #70807c;
  font-size: 9px;
}
.hsk-guided-completion nav {
  margin-top: 25px;
  display: flex;
  gap: 10px;
}
.hsk-guided-completion nav a {
  min-height: 43px;
  padding: 0 15px;
  display: flex;
  align-items: center;
  color: var(--guided-green-deep);
  border: 1px solid #c5ded8;
  border-radius: 13px;
  background: #fff;
  font-size: 10px;
  font-weight: 740;
}
.hsk-guided-completion nav a:last-child {
  color: #fff;
  border-color: var(--guided-green);
  background: var(--guided-green);
}
.hsk-guided-footer {
  position: fixed;
  z-index: 25;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 78px;
  padding: 12px max(24px, calc((100vw - 960px) / 2));
  display: grid;
  grid-template-columns: 130px 1fr 130px;
  align-items: center;
  gap: 20px;
  border-top: 1px solid #e2e8e6;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 -8px 28px rgba(29, 70, 60, .05);
  backdrop-filter: blur(16px);
}
.hsk-guided-footer > button {
  min-height: 44px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  color: #526762;
  border: 1px solid #d9e3e0;
  border-radius: 13px;
  background: #fff;
  font-size: 11px;
  font-weight: 740;
}
.hsk-guided-footer > button:disabled {
  cursor: not-allowed;
  opacity: .38;
}
.hsk-guided-footer > button.is-primary {
  color: #fff;
  border-color: var(--guided-green);
  background: var(--guided-green);
}
.hsk-guided-footer > span {
  color: #7a8783;
  text-align: center;
  font-size: 9px;
  font-weight: 700;
}
@media (max-width: 820px) {
  .hsk-guided-toolbar {
    grid-template-columns: 38px minmax(100px, 1fr) auto auto;
  }
  .hsk-guided-speed {
    grid-column: 1 / -1;
    display: none;
  }
  .hsk-guided-word-grid {
    grid-template-columns: 1fr;
  }
  .hsk-guided-writing-layout {
    grid-template-columns: 1fr;
  }
  .hsk-guided-writing-layout > aside {
    grid-template-columns: auto 1fr auto;
    text-align: left;
  }
  .hsk-guided-writing-layout > aside > strong {
    grid-row: 1 / span 3;
    margin-right: 16px;
    font-size: 62px;
  }
  .hsk-guided-writing-layout > aside > div {
    margin: 0;
  }
  .hsk-guided-writing-layout > aside > p {
    margin: 4px 0 0;
  }
  .hsk-guided-writing-layout > aside > button {
    grid-column: 3;
    grid-row: 1 / span 3;
  }
}
@media (max-width: 620px) {
  .hsk-guided-toolbar {
    width: calc(100% - 20px);
    min-height: 54px;
    grid-template-columns: 34px minmax(80px, 1fr) auto auto;
    gap: 8px;
  }
  .hsk-guided-toolbar > a {
    width: 34px;
    height: 34px;
  }
  .hsk-guided-progress {
    height: 8px;
  }
  .hsk-guided-toolbar > strong {
    font-size: 10px;
  }
  .hsk-guided-pinyin {
    min-height: 32px;
    padding-inline: 7px;
  }
  .hsk-guided-sections {
    width: calc(100% - 16px);
    min-height: 47px;
  }
  .hsk-guided-sections button {
    min-height: 32px;
    padding-inline: 9px;
    font-size: 10px;
  }
  .hsk-guided-main {
    width: calc(100% - 24px);
    padding: 28px 0 110px;
  }
  .hsk-guided-stats {
    grid-template-columns: 1fr 1fr;
  }
  .hsk-guided-hero-character {
    min-width: 92px;
    min-height: 92px;
    padding: 10px 18px;
    border-radius: 25px;
    font-size: 34px;
  }
  .hsk-guided-word-heading {
    align-items: center;
    justify-content: space-between;
  }
  .hsk-guided-word-heading > div {
    display: grid;
    gap: 4px;
  }
  .hsk-guided-word-heading > div > strong {
    font-size: 76px;
  }
  .hsk-guided-word-heading > div > span {
    font-size: 17px;
  }
  .hsk-guided-grammar-examples {
    grid-template-columns: 1fr;
  }
  .hsk-guided-dialogue-title {
    align-items: flex-start;
    display: grid;
  }
  .hsk-guided-dialogue-list {
    padding: 10px;
  }
  .hsk-guided-dialogue-list article {
    grid-template-columns: 34px minmax(0, 1fr) 32px;
    gap: 8px;
  }
  .hsk-guided-dialogue-list article > span {
    width: 33px;
    height: 33px;
  }
  .hsk-guided-practice {
    padding: 24px 14px;
  }
  .hsk-guided-practice-options {
    grid-template-columns: 1fr;
  }
  .hsk-guided-completion > div {
    grid-template-columns: 1fr;
  }
  .hsk-guided-completion nav {
    width: 100%;
    display: grid;
  }
  .hsk-guided-completion nav a {
    justify-content: center;
  }
  .hsk-guided-footer {
    min-height: 68px;
    padding: 10px 12px;
    grid-template-columns: 108px 1fr 108px;
    gap: 8px;
  }
  .hsk-guided-footer > button {
    min-height: 42px;
    padding-inline: 10px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .hsk-guided-main > section {
    animation: none;
  }
  .hsk-guided-progress > span {
    transition: none;
  }
}
:root {
  --ink: #16342f;
  --ink-soft: #49625d;
  --forest: #176b5b;
  --forest-deep: #0f5146;
  --sage: #dcebe2;
  --sage-light: #eff6f1;
  --paper: #fbfaf5;
  --surface: #ffffff;
  --sand: #f1eadb;
  --amber: #dd9b42;
  --line: #dfe8e2;
  --shadow: 0 18px 55px rgba(26, 69, 59, 0.1);
  --radius-lg: 28px;
  --radius-md: 18px;
}
body:has(.admin-page) {
  padding-bottom: 0;
  background: #f5f6f7;
}
body:has(.admin-page) > .site-header,
body:has(.admin-page) > .site-footer,
body:has(.admin-page) > .mobile-nav {
  display: none;
}
.standalone-route-shell:has(.admin-page) {
  min-height: 100vh;
}
.admin-page {
  --admin-accent: #ef7b36;
  --admin-accent-dark: #d96422;
  --admin-bg: #f5f6f7;
  --admin-border: #e5e7eb;
  --admin-muted: #7c828d;
  --admin-text: #24272d;
  min-height: 100vh;
  padding: 0;
  color: var(--admin-text);
  background: var(--admin-bg);
}
.admin-page > .section-shell {
  width: 100%;
  max-width: none;
  padding: 0 32px 64px 266px;
}
.admin-sidebar {
  position: fixed;
  z-index: 20;
  inset: 0 auto 0 0;
  width: 234px;
  padding: 20px 14px 16px;
  display: flex;
  flex-direction: column;
  color: #4d535d;
  border-right: 1px solid var(--admin-border);
  background: #fbfbfc;
}
.admin-sidebar-brand {
  min-height: 52px;
  padding: 5px 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--admin-text);
}
.admin-sidebar-brand > span {
  width: 38px;
  height: 38px;
  overflow: hidden;
  display: grid;
  place-items: center;
  border: 1px solid #e3e5e8;
  border-radius: 10px;
  background: #fff;
}
.admin-sidebar-brand img {
  width: 36px;
  height: 36px;
  object-fit: contain;
}
.admin-sidebar-brand > div,
.admin-sidebar-footer a > span:not(.admin-user-avatar) {
  min-width: 0;
  display: grid;
  gap: 2px;
}
.admin-sidebar-brand strong {
  font-size: 12px;
  font-weight: 760;
  letter-spacing: -.015em;
}
.admin-sidebar-brand small,
.admin-sidebar-footer small {
  color: #9a9fa8;
  font-size: 9px;
}
.admin-nav {
  margin: 23px 0 0;
  padding: 0;
  display: grid;
  gap: 21px;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.admin-nav-group {
  display: grid;
  gap: 7px;
}
.admin-nav-group > span {
  padding: 0 10px;
  color: #a4a8b0;
  font-size: 8px;
  font-weight: 750;
  letter-spacing: .09em;
  text-transform: uppercase;
}
.admin-nav-group > div {
  display: grid;
  gap: 3px;
}
.admin-nav a {
  min-height: 38px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #707680;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 650;
}
.admin-nav a:hover {
  color: #30343a;
  background: #f0f1f2;
}
.admin-nav a.active,
.admin-nav a[aria-current="page"] {
  color: #2d3036;
  background: #fff;
  box-shadow: 0 1px 3px rgba(25, 29, 35, .08), inset 3px 0 var(--admin-accent);
}
.admin-nav a.active svg,
.admin-nav a[aria-current="page"] svg {
  color: var(--admin-accent);
}
.admin-nav a.pending {
  color: var(--admin-accent-dark);
  background: #fff8f4;
}
.admin-nav-spinner {
  animation: admin-nav-spin .75s linear infinite;
}
.admin-route-progress {
  position: fixed;
  z-index: 90;
  top: 0;
  left: 234px;
  right: 0;
  height: 2px;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
  transition: opacity .12s ease;
}
.admin-route-progress.active {
  opacity: 1;
}
.admin-route-progress > span {
  width: 42%;
  height: 100%;
  display: block;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, var(--admin-accent), transparent);
  animation: admin-route-progress 1s ease-in-out infinite;
}
@keyframes admin-nav-spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes admin-route-progress {
  from {
    transform: translateX(-110%);
  }
  to {
    transform: translateX(340%);
  }
}
.admin-sidebar-footer {
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--admin-border);
}
.admin-sidebar-footer a {
  min-height: 48px;
  padding: 6px 7px;
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  color: var(--admin-text);
  border-radius: 9px;
}
.admin-sidebar-footer a:hover {
  background: #f0f1f2;
}
.admin-sidebar-footer strong {
  overflow: hidden;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.admin-user-avatar {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: #fff;
  border-radius: 50%;
  background: #26292f;
  font-size: 10px;
  font-weight: 800;
}
.admin-top {
  min-height: 112px;
  margin: 0 -32px;
  padding: 22px 32px 19px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid var(--admin-border);
  background: rgba(255, 255, 255, .92);
}
.admin-title {
  min-width: 0;
}
.admin-title > span {
  color: var(--admin-accent-dark);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .09em;
  text-transform: uppercase;
}
.admin-title h1 {
  margin: 4px 0 0;
  color: #202329;
  font-size: 24px;
  font-weight: 690;
  letter-spacing: -.035em;
  line-height: 1.15;
}
.admin-title p {
  max-width: 760px;
  margin: 6px 0 0;
  color: var(--admin-muted);
  font-size: 10px;
  line-height: 1.5;
