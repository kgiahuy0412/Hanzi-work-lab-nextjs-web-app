.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}
.panel-heading h2 {
  margin: 0;
  font-size: 17px;
}
.panel-heading span {
  color: var(--ink-soft);
  font-size: 10px;
}
.panel-heading a {
  color: var(--forest);
  font-size: 10px;
  font-weight: 800;
}
.data-table {
  width: 100%;
  margin-top: 18px;
  border-collapse: collapse;
}
.data-table th, .data-table td {
  padding: 13px 8px;
  text-align: left;
  border-bottom: 1px solid #edf1ee;
  font-size: 11px;
}
.data-table th {
  color: var(--ink-soft);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.table-course {
  display: flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
}
.table-course > span:not(.table-mark) {
  display: grid;
  gap: 3px;
}
.table-course small {
  color: var(--ink-soft);
  font-size: 9px;
  font-weight: 500;
}
.table-mark {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  color: var(--forest-deep);
  border-radius: 9px;
  background: var(--sage);
  font-family: Georgia, serif;
}
.status {
  width: fit-content;
  padding: 5px 7px;
  border-radius: 7px;
  font-size: 9px;
  font-weight: 750;
}
.status.live {
  color: var(--forest-deep);
  background: var(--sage);
}
.status.draft {
  color: #80591d;
  background: #fff3d9;
}
.status.published {
  color: var(--forest-deep);
  background: var(--sage);
}
.status.review {
  color: #73571a;
  background: #fff2c8;
}
.status.archived {
  color: #65706c;
  background: #edf0ee;
}
.pipeline {
  margin-top: 20px;
  display: grid;
  gap: 13px;
}
.pipeline-step {
  display: grid;
  grid-template-columns: 30px 1fr auto;
  align-items: center;
  gap: 10px;
}
.pipeline-step > span:first-child {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  color: var(--forest);
  border-radius: 9px;
  background: var(--sage-light);
  font-size: 10px;
  font-weight: 800;
}
.pipeline-step div {
  display: grid;
  gap: 2px;
}
.pipeline-step strong {
  font-size: 11px;
}
.pipeline-step div span, .pipeline-step > strong {
  color: var(--ink-soft);
  font-size: 9px;
}
.pipeline-step > strong {
  color: var(--forest);
}
.admin-lower {
  margin-top: 16px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.admin-lower.one {
  grid-template-columns: 1fr;
}
.admin-message {
  margin: 18px 0 0;
  padding: 13px 15px;
  border-radius: 11px;
  font-size: 12px;
  line-height: 1.5;
}
.admin-message.success {
  color: var(--forest-deep);
  border: 1px solid #bdd9ce;
  background: #eef8f3;
}
.admin-message.error {
  color: #8b3f35;
  border: 1px solid #efc5bd;
  background: #fff2ef;
}
.admin-content-grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: minmax(340px,.78fr) minmax(0,1.22fr);
  gap: 16px;
  align-items: start;
}
.admin-detail-grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: minmax(0,1fr) 300px;
  gap: 16px;
  align-items: start;
}
.admin-detail-grid.lesson-layout {
  grid-template-columns: minmax(0,1fr) 320px;
}
.admin-side-stack {
  display: grid;
  gap: 16px;
}
.modules-section {
  margin-top: 16px;
}
.admin-form {
  margin-top: 20px;
  display: grid;
  gap: 15px;
}
.admin-form-grid {
  display: grid;
  gap: 13px;
}
.admin-form-grid.two {
  grid-template-columns: repeat(2, minmax(0,1fr));
}
.admin-form label {
  display: grid;
  gap: 7px;
  color: var(--ink);
  font-size: 11px;
  font-weight: 750;
}
.admin-form input:not([type="checkbox"]), .admin-form select, .admin-form textarea, .admin-search input {
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  color: var(--ink);
  border: 1px solid #d5dfda;
  border-radius: 10px;
  outline: none;
  background: #fff;
  font: inherit;
  font-size: 12px;
}
.admin-form input[type="color"] {
  min-height: 44px;
  padding: 5px;
}
.admin-form textarea {
  resize: vertical;
  line-height: 1.55;
}
.admin-form input:focus, .admin-form select:focus, .admin-form textarea:focus, .admin-search input:focus {
  border-color: var(--forest);
  box-shadow: 0 0 0 3px rgba(23,107,91,.1);
}
.admin-form .button {
  justify-self: start;
}
.admin-check {
  width: fit-content;
  display: flex !important;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 8px !important;
}
.admin-check input, .admin-delete-form input, .vocabulary-picker input {
  accent-color: var(--forest);
}
.admin-editor-help {
  margin-bottom: -8px;
  display: flex;
  justify-content: space-between;
  gap: 14px;
}
.admin-editor-help strong {
  font-size: 12px;
}
.admin-editor-help span {
  color: var(--ink-soft);
  font-size: 10px;
}
.vocabulary-picker {
  margin: 4px 0 0;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 12px;
}
.vocabulary-picker legend {
  padding: 0 7px;
  color: var(--forest-deep);
  font-size: 11px;
  font-weight: 800;
}
.vocabulary-picker > div {
  max-height: 360px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 8px;
  overflow-y: auto;
}
.vocabulary-picker label {
  padding: 10px;
  display: grid;
  grid-template-columns: auto auto 1fr;
  align-items: center;
  gap: 8px;
  border: 1px solid #edf1ee;
  border-radius: 9px;
  cursor: pointer;
}
.vocabulary-picker label:hover {
  background: #f7faf8;
}
.vocabulary-picker span {
  font-family: Georgia,"Times New Roman",serif;
  font-size: 18px;
}
.vocabulary-picker small {
  color: var(--ink-soft);
  font-size: 9px;
  line-height: 1.4;
}
.admin-record-list {
  margin-top: 16px;
  display: grid;
  gap: 9px;
}
.admin-record-list > a {
  min-height: 62px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  color: var(--ink);
  border: 1px solid #e7ece9;
  border-radius: 11px;
}
.admin-record-list > a:hover {
  border-color: #bdd9ce;
  background: #f5faf7;
}
.admin-record-list a > span {
  display: grid;
  gap: 5px;
}
.admin-record-list strong {
  font-size: 12px;
}
.admin-record-list small {
  color: var(--ink-soft);
  font-size: 10px;
}
.admin-record-list b {
  color: var(--forest);
  font-size: 10px;
  white-space: nowrap;
}
.vocabulary-list {
  max-height: 700px;
  overflow-y: auto;
}
.vocabulary-list strong[lang="zh"] {
  font-family: Georgia,"Times New Roman",serif;
  font-size: 21px;
}
.admin-search {
  margin-top: 16px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}
.admin-search .button {
  min-height: 44px;
}
.admin-empty {
  margin: 18px 0 0;
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.6;
}
.danger-panel {
  border-color: #ecd0ca;
  background: #fffafa;
}
.danger-panel h2 {
  margin: 0 0 7px;
  font-size: 16px;
}
.danger-panel p {
  margin: 0;
  color: #7d5a53;
  font-size: 11px;
  line-height: 1.6;
}
.admin-delete-form {
  margin-top: 16px;
  display: grid;
  gap: 12px;
}
.admin-delete-form label {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  color: #7d5a53;
  font-size: 10px;
  line-height: 1.5;
}
.button-danger {
  color: #fff;
  background: #a64e42;
}
.button-danger:hover {
  background: #8d4036;
}
.practice-review-queue {
  margin-top: 18px;
  padding-top: 20px;
  border-top: 3px solid var(--forest);
}
.practice-review-queue-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px;
}
.practice-review-queue-heading > div {
  max-width: 680px;
}
.practice-review-queue-heading > div > span {
  color: var(--forest);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.practice-review-queue-heading h2 {
  margin: 6px 0 0;
  font-size: 21px;
  letter-spacing: -.025em;
}
.practice-review-queue-heading p {
  margin: 7px 0 0;
  color: var(--ink-soft);
  font-size: 10px;
  line-height: 1.55;
}
.practice-review-queue-heading dl {
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(68px, 1fr));
}
.practice-review-queue-heading dl > div {
  min-width: 76px;
  padding: 3px 14px;
  border-left: 1px solid var(--line);
}
.practice-review-queue-heading dt {
  color: var(--ink-soft);
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: .07em;
}
.practice-review-queue-heading dd {
  margin: 4px 0 0;
  color: var(--forest-deep);
  font-size: 20px;
  font-weight: 800;
}
.practice-review-queue-heading dl > div.is-alert dd {
  color: #a34e37;
}
.practice-review-queue-list {
  margin-top: 18px;
  border-bottom: 1px solid var(--line);
}
.practice-review-queue-list > article {
  min-height: 132px;
  padding: 18px 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(390px, .82fr);
  gap: 26px;
  align-items: center;
  border-top: 1px solid var(--line);
}
.practice-review-queue-list > article.is-overdue {
  box-shadow: inset 3px 0 #d06a55;
}
.practice-review-task-copy {
  min-width: 0;
  padding-left: 10px;
  display: grid;
  gap: 9px;
}
.practice-review-task-meta, .practice-review-task-status {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px 12px;
  color: var(--ink-soft);
  font-size: 8px;
}
.practice-review-priority {
  width: fit-content;
  padding: 4px 7px;
  border-radius: 999px;
  color: #50635c;
  background: #edf2ef;
  font-size: 8px;
  font-weight: 850;
  line-height: 1;
  white-space: nowrap;
}
.practice-review-priority.high {
  color: #84601d;
  background: #fff0c9;
}
.practice-review-priority.urgent {
  color: #9a4538;
  background: #fce7e1;
}
.practice-review-task-copy > a {
  min-width: 0;
  display: grid;
  gap: 5px;
  color: var(--ink);
}
.practice-review-task-copy > a strong {
  font-size: 14px;
}
.practice-review-task-copy > a span {
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 10px;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.practice-review-task-status span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.practice-review-task-status .overdue {
  color: #a34e37;
  font-weight: 780;
}
.practice-review-assignment-form {
  display: grid;
  grid-template-columns: minmax(130px, 1.2fr) minmax(100px, .8fr) minmax(120px, .8fr);
  gap: 8px;
  align-items: end;
}
.practice-review-assignment-form label {
  display: grid;
  gap: 5px;
  color: var(--ink-soft);
  font-size: 8px;
  font-weight: 780;
}
.practice-review-assignment-form select, .practice-review-assignment-form input {
  width: 100%;
  min-height: 36px;
  padding: 0 8px;
  color: var(--ink);
  border: 1px solid #d4ded9;
  border-radius: 8px;
  background: #fff;
  font: inherit;
  font-size: 9px;
}
.practice-review-assignment-form .button {
  min-height: 36px;
  grid-column: 1 / -1;
  justify-self: end;
  padding-inline: 12px;
  font-size: 9px;
}
.practice-review-task-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 7px;
}
.practice-review-task-actions .button {
  min-height: 38px;
  padding-inline: 12px;
  font-size: 9px;
}
.practice-review-assignment-panel {
  overflow: hidden;
}
.practice-review-owner {
  margin-top: 15px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--forest);
  border-radius: 11px;
  background: #f1f7f4;
}
.practice-review-owner > div {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.practice-review-owner span {
  color: var(--ink-soft);
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: .07em;
}
.practice-review-owner strong {
  overflow: hidden;
  color: var(--ink);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.practice-review-due {
  margin: 10px 0 0;
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--ink-soft);
  font-size: 9px;
}
.practice-review-due.is-overdue {
  color: #a34e37;
  font-weight: 780;
}
.practice-review-assignment-form.detail {
  margin-top: 15px;
  padding-top: 15px;
  grid-template-columns: 1fr;
  border-top: 1px solid var(--line);
}
.practice-review-assignment-form.detail .button {
  grid-column: 1;
  justify-self: stretch;
}
.practice-review-panel-actions {
  margin-top: 14px;
}
.practice-review-panel-actions .button {
  width: 100%;
}
.practice-review-list-note {
  color: #8b611c !important;
  font-weight: 700;
}
.practice-version-history {
  margin-top: 24px;
  overflow: hidden;
}
.practice-version-history > .panel-heading {
  align-items: flex-end;
}
.practice-version-history > .panel-heading > div {
  display: grid;
  gap: 7px;
}
.practice-version-history > .panel-heading h2 {
  margin: 0;
}
.practice-version-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--forest);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .09em;
  text-transform: uppercase;
}
.practice-version-intro {
  max-width: 720px;
  margin: 10px 0 0;
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.65;
}
.practice-version-timeline {
  position: relative;
  margin-top: 20px;
  padding-left: 28px;
}
.practice-version-timeline::before {
  position: absolute;
  inset: 10px auto 12px 7px;
  width: 1px;
  content: "";
  background: #ccdcd5;
}
.practice-version-item {
  position: relative;
  border-top: 1px solid var(--line);
}
.practice-version-item:last-child {
  border-bottom: 1px solid var(--line);
}
.practice-version-item summary {
  position: relative;
  min-height: 66px;
  padding: 13px 30px 13px 2px;
  display: grid;
  grid-template-columns: 45px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  cursor: pointer;
  list-style: none;
}
.practice-version-item summary::-webkit-details-marker {
  display: none;
}
.practice-version-item summary::after {
  position: absolute;
  top: 50%;
  right: 3px;
  color: var(--ink-soft);
  content: "+";
  font-size: 16px;
  line-height: 1;
  transform: translateY(-50%);
}
.practice-version-item[open] summary::after {
  content: "−";
}
.practice-version-node {
  position: absolute;
  top: 29px;
  left: -25px;
  width: 9px;
  height: 9px;
  border: 2px solid #f8faf8;
  border-radius: 50%;
  background: #8ca99d;
  box-shadow: 0 0 0 1px #afc5bc;
}
.practice-version-item.is-latest .practice-version-node {
  width: 12px;
  height: 12px;
  top: 27px;
  left: -27px;
  background: var(--forest);
  box-shadow: 0 0 0 4px #e1f1eb;
}
.practice-version-number {
  width: 42px;
  height: 30px;
  display: grid;
  place-items: center;
  color: var(--forest-deep);
  border-radius: 8px;
  background: #edf5f1;
  font-size: 10px;
  font-weight: 850;
}
.practice-version-summary {
  min-width: 0;
  display: grid;
  gap: 5px;
}
.practice-version-summary strong {
  overflow: hidden;
  font-size: 11px;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.practice-version-summary small {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--ink-soft);
  font-size: 9px;
}
.practice-version-current, .practice-version-invalid {
  margin-right: 25px;
  padding: 5px 8px;
  grid-column: 3;
  grid-row: 1;
  justify-self: end;
  border-radius: 999px;
  color: #08725f;
  background: #dff4ec;
  font-size: 8px;
  font-weight: 850;
  text-transform: uppercase;
  white-space: nowrap;
}
.practice-version-invalid {
  color: #8b635b;
  background: #f6ebe7;
}
.practice-version-item summary > .status {
  margin-right: 25px;
  grid-column: 3;
  grid-row: 1;
  justify-self: end;
  white-space: nowrap;
}
.practice-version-content {
  margin: 0 0 18px;
  padding: 18px;
  display: grid;
  gap: 15px;
  border-radius: 14px;
  background: #f5f8f6;
}
.practice-version-overview {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24px;
  align-items: start;
}
.practice-version-overview > div {
  display: grid;
  gap: 5px;
}
.practice-version-overview > div > span {
  color: var(--ink-soft);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
}
.practice-version-overview > div > strong {
  font-size: 17px;
}
.practice-version-overview p {
  max-width: 650px;
  margin: 0;
  color: var(--ink-soft);
  font-size: 10px;
  line-height: 1.6;
}
.practice-version-overview dl {
  margin: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(64px, auto));
  gap: 5px;
}
.practice-version-overview dl > div {
  min-width: 68px;
  padding-left: 12px;
  border-left: 1px solid #d6e1dc;
}
.practice-version-overview dt {
  color: var(--ink-soft);
  font-size: 8px;
}
.practice-version-overview dd {
  margin: 5px 0 0;
  color: var(--forest-deep);
  font-size: 10px;
  font-weight: 800;
}
.practice-version-focus {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.practice-version-focus span {
  padding: 5px 8px;
  border-radius: 999px;
  color: var(--forest-deep);
  background: #e4f0eb;
  font-size: 8px;
  font-weight: 750;
}
.practice-version-exercises {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 24px;
}
.practice-version-exercises > div {
  min-height: 48px;
  padding: 9px 0;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto;
  gap: 9px;
  align-items: center;
  border-top: 1px solid #d9e4df;
}
.practice-version-exercises > div > span {
  color: #789188;
  font-size: 9px;
  font-weight: 850;
}
.practice-version-exercises > div > div {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.practice-version-exercises strong {
  font-size: 10px;
}
.practice-version-exercises small {
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.practice-version-exercises b {
  font-size: 8px;
  text-transform: uppercase;
}
.practice-version-exercises b.true {
  color: #08725f;
}
.practice-version-exercises b.false {
  color: #a34e37;
}
.practice-version-restore-form {
  padding-top: 16px;
  display: grid;
  grid-template-columns: minmax(180px, .8fr) minmax(280px, 1.2fr) auto;
  gap: 14px;
  align-items: end;
  border-top: 1px solid #d6e1dc;
}
.practice-version-restore-form > div {
  align-self: center;
}
.practice-version-restore-form > div strong {
  font-size: 11px;
}
.practice-version-restore-form > div p {
  margin: 4px 0 0;
  color: var(--ink-soft);
  font-size: 9px;
  line-height: 1.5;
}
.practice-version-restore-form > label:not(.practice-version-confirm) {
  display: grid;
  gap: 5px;
  color: var(--ink-soft);
  font-size: 9px;
