  z-index: 0;
  inset: 0;
  display: block;
  pointer-events: none;
}
.game-journey-background img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: fill;
}
.game-journey-header {
  width: 550px;
  position: absolute;
  z-index: 5;
  left: 4.6%;
  top: 4%;
}
.game-journey-status {
  width: max-content;
  position: absolute;
  z-index: 5;
  left: 4.6%;
  top: 4%;
}
.game-journey-status .game-journey-progress {
  margin-top: 0;
}
.game-journey-header > span,
.game-journey-featured-card > small {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #08786d;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .12em;
}
.game-journey-header h1 {
  margin: 14px 0 4px;
  color: #0b5148;
  font-size: clamp(44px, 4.4vw, 62px);
  line-height: .98;
  letter-spacing: -.055em;
  white-space: nowrap;
}
.game-journey-header p {
  margin: 0;
  color: #64766f;
  font-size: 15px;
}
.game-journey-progress {
  width: max-content;
  min-height: 40px;
  margin-top: 17px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #0b756a;
  border: 1px solid rgba(154, 197, 184, .72);
  border-radius: 999px;
  background: rgba(255, 253, 247, .9);
  box-shadow: 0 9px 24px rgba(59, 98, 85, .07);
  font-size: 12px;
}
.game-journey-progress strong {
  font-size: 14px;
}
.game-journey-progress span {
  color: #71837c;
}
.game-progress-sync {
  margin-top: 8px;
  display: block;
  color: #64776f;
  font-size: 10px;
  font-weight: 700;
}
.game-progress-sync.is-error {
  color: #9d5b2c;
}
.game-journey-featured {
  width: 520px;
  min-height: 340px;
  position: absolute;
  z-index: 4;
  left: 4.8%;
  top: 27%;
}
.game-journey-featured-card {
  width: 310px;
  min-height: 300px;
  padding: 25px 25px 22px;
  position: relative;
  z-index: 2;
  border: 1px solid rgba(213, 226, 218, .88);
  border-radius: 24px;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 18px 44px rgba(44, 78, 66, .13);
}
.game-journey-featured-number,
.game-journey-station-number {
  display: grid;
  place-items: center;
  color: #fff;
  border: 5px solid rgba(255, 255, 255, .82);
  border-radius: 50%;
  background: #08786d;
  box-shadow: 0 8px 20px rgba(24, 100, 87, .17);
  font-weight: 850;
}
.game-journey-featured-number {
  width: 54px;
  height: 54px;
  margin: -13px 0 17px -13px;
  font-size: 16px;
}
.game-journey-done {
  min-height: 28px;
  padding: 0 10px;
  position: absolute;
  right: 18px;
  top: 18px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #08786d;
  border-radius: 999px;
  background: #e2f5ef;
  font-size: 9px;
  font-weight: 800;
}
.game-journey-featured-card h2 {
  margin: 8px 0 8px;
  color: #123f37;
  font-size: 31px;
  letter-spacing: -.045em;
}
.game-journey-featured-card p {
  margin: 0;
  color: #65766f;
  font-size: 11px;
  line-height: 1.65;
}
.game-journey-featured-meta {
  margin-top: 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
}
.game-journey-featured-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #687a73;
  font-size: 9px;
  font-weight: 700;
}
.game-journey-featured-card button {
  min-height: 48px;
  margin-top: 17px;
  padding: 0 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  color: #fff;
  border: 0;
  border-radius: 13px;
  background: #ff5c57;
  box-shadow: 0 12px 24px rgba(220, 79, 73, .2);
  font: inherit;
  font-size: 11px;
  font-weight: 820;
  transition: transform .2s ease, box-shadow .2s ease;
}
.game-journey-featured-card button:hover {
  box-shadow: 0 15px 28px rgba(220, 79, 73, .25);
  transform: translateY(-2px);
}
.game-journey-guide {
  width: 250px;
  height: auto;
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  filter: drop-shadow(0 18px 17px rgba(34, 75, 63, .16));
  animation: game-journey-guide-float 4.2s ease-in-out infinite;
}
.game-journey-traveler {
  width: clamp(76px, 7.2vw, 108px);
  aspect-ratio: 1;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 7;
  object-fit: contain;
  pointer-events: none;
  opacity: 0;
  filter: drop-shadow(0 12px 13px rgba(34, 75, 63, .17));
  transform-origin: 50% 78%;
  will-change: transform, opacity;
}
.game-journey-stations {
  position: absolute;
  z-index: 3;
  inset: 0;
}
.game-journey-station {
  --game-station-rest-transform: translate(-50%, calc(-50% - 10px)) scale(1);
  --game-station-hover-transform: translate(-50%, calc(-50% - 18px)) scale(1.045);
  width: clamp(184px, 13vw, 208px);
  min-height: clamp(154px, 10.6vw, 170px);
  padding: 0;
  position: absolute;
  display: grid;
  justify-items: center;
  cursor: pointer;
  color: #163f38;
  border: 0;
  background: transparent;
  font: inherit;
  text-align: center;
  transform: var(--game-station-rest-transform);
  transform-origin: 50% 58%;
  transition: transform .48s cubic-bezier(.16, 1, .3, 1),
    filter .36s ease;
  will-change: transform;
}
.game-journey-station:is(:hover, :focus-visible) {
  z-index: 5;
  filter: drop-shadow(0 16px 18px rgba(34, 75, 63, .16));
  transform: var(--game-station-hover-transform);
}
.game-journey-station:active {
  transition-duration: .12s;
}
.game-journey-station-number {
  width: 42px;
  height: 42px;
  position: absolute;
  z-index: 3;
  left: 4px;
  top: -3px;
  font-size: 13px;
  transition: transform .46s cubic-bezier(.16, 1, .3, 1), box-shadow .36s ease;
}
.game-journey-station-visual {
  width: clamp(158px, 10.8vw, 176px);
  height: clamp(105px, 7.2vw, 118px);
  position: relative;
  display: block;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.game-journey-station-visual > img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  filter: none;
  transform-origin: 50% 72%;
  transition: transform .52s cubic-bezier(.16, 1, .3, 1), filter .36s ease;
}
.game-journey-station:is(:hover, :focus-visible) .game-journey-station-visual > img {
  filter: saturate(1.04);
  transform: translateY(-3px) scale(1.035);
}
.game-journey-station:is(:hover, :focus-visible) .game-journey-station-number {
  transform: translate(-2px, -3px) rotate(-4deg) scale(1.06);
}
.game-journey-station-icon {
  width: 32px;
  height: 32px;
  position: absolute;
  left: 7px;
  bottom: 7px;
  display: none;
  place-items: center;
  border: 3px solid rgba(255, 255, 255, .9);
  border-radius: 10px;
  box-shadow: 0 7px 14px rgba(53, 73, 66, .11);
}
.game-journey-station-icon.tone-coral {
  color: #af433c;
  background: #ffe7e4;
}
.game-journey-station-icon.tone-blue {
  color: #2769b6;
  background: #e5f0ff;
}
.game-journey-station-icon.tone-gold {
  color: #9b6b0d;
  background: #fff1c7;
}
.game-journey-station-icon.tone-violet {
  color: #6552a4;
  background: #eee9ff;
}
.game-journey-station-icon.tone-rose {
  color: #a44d74;
  background: #ffe7f1;
}
.game-journey-station-icon.tone-teal {
  color: #08786d;
  background: #ddf4ef;
}
.game-journey-station-copy {
  margin-top: 3px;
  display: grid;
  gap: 3px;
}
.game-journey-station-copy strong {
  font-size: 12px;
  letter-spacing: -.015em;
}
.game-journey-station-copy small {
  color: #71817b;
  font-size: 8px;
  font-weight: 650;
}
.game-journey-station-complete {
  min-height: 25px;
  padding: 0 9px;
  position: absolute;
  z-index: 4;
  right: 2px;
  top: 4px;
  display: none;
  align-items: center;
  gap: 4px;
  color: #08786d;
  border-radius: 999px;
  background: #e2f5ef;
  box-shadow: 0 7px 16px rgba(34, 87, 75, .1);
  font-size: 8px;
  font-weight: 800;
}
.game-journey-station.station-2 {
  left: 57.1%;
  top: 17.7%;
}
.game-journey-station.station-3 {
  left: 78.8%;
  top: 32.4%;
}
.game-journey-station.station-4 {
  left: 82.6%;
  top: 58.8%;
}
.game-journey-station.station-5 {
  left: 64.9%;
  top: 73.6%;
}
.game-journey-station.station-6 {
  left: 39.8%;
  top: 77.9%;
}
.game-journey-station.station-7 {
  left: 14.3%;
  top: 77.1%;
}
.game-journey-skills {
  width: 236px;
  min-height: 95px;
  padding: 14px 16px;
  position: absolute;
  z-index: 4;
  right: 4%;
  bottom: 4%;
  color: #557068;
  border: 1px solid rgba(206, 221, 213, .9);
  border-radius: 18px;
  background: rgba(255, 255, 255, .9);
  box-shadow: 0 12px 30px rgba(43, 77, 66, .08);
}
.game-journey-skills > strong {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #0b7166;
  font-size: 9px;
}
.game-journey-skills > div {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.game-journey-skills span {
  display: grid;
  justify-items: center;
  gap: 5px;
  border-left: 1px solid #e1e8e3;
}
.game-journey-skills span:first-child {
  border-left: 0;
}
.game-journey-skills small {
  font-size: 8px;
}
@keyframes game-journey-guide-float {
  0%, 100% {
    transform: translateY(0) rotate(-2deg);
  }
  50% {
    transform: translateY(-7px) rotate(1deg);
  }
}
.game-session-shell {
  max-width: 1220px;
}
.game-session-header {
  min-height: 154px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 28px;
}
.game-back-button,
.writing-back-to-games {
  width: max-content;
  grid-column: 1 / -1;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  cursor: pointer;
  color: #507069;
  border: 0;
  background: transparent;
  font: inherit;
  font-size: 10px;
  font-weight: 760;
}
.writing-back-to-games {
  margin-bottom: 10px;
}
.game-session-header > div > span {
  color: #08786d;
}
.game-session-header h1 {
  margin: 7px 0 5px;
  color: #133c35;
  font-size: clamp(34px, 4vw, 51px);
  line-height: 1;
  letter-spacing: -.05em;
}
.game-session-header p {
  margin: 0;
  color: #667872;
  font-size: 11px;
}
.game-session-metrics {
  display: flex;
  gap: 10px;
}
.game-session-metrics > span {
  min-width: 86px;
  min-height: 60px;
  padding: 10px 13px;
  display: grid;
  align-content: center;
  border: 1px solid #dce5e0;
  border-radius: 13px;
  background: #fff;
}
.game-session-metrics strong {
  color: #0a766a;
  font-size: 19px;
}
.game-session-metrics small {
  margin-top: 2px;
  color: #7b8985;
  font-size: 8px;
}
.game-play-card {
  min-height: 560px;
  margin-top: 26px;
  padding: 24px;
  position: relative;
  border: 1px solid #dce4df;
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 18px 48px rgba(28, 67, 57, .08);
}
.game-instruction {
  min-height: 48px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #5e716b;
  border-radius: 12px;
  background: #f0f6f2;
  font-size: 10px;
}
.game-instruction svg {
