  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(400px, 500px);
  align-items: center;
  gap: 22px;
  overflow: hidden;
  border: 1px solid rgba(220, 208, 185, .78);
  border-radius: 26px;
  background: radial-gradient(circle at 9% 4%, rgba(255, 255, 255, .95), transparent 33%),
    radial-gradient(circle at 92% 12%, rgba(255, 203, 112, .25), transparent 25%),
    linear-gradient(126deg, #fffaf1 0%, #fff4e7 50%, #e1f4eb 100%);
  box-shadow: 0 18px 48px rgba(35, 83, 69, .09);
}
