  border-radius: 50%;
  background: #fff1bd;
}
.game-result > small {
  margin-top: 16px;
  color: #08786d;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .1em;
}
.game-result h2 {
  max-width: 520px;
  margin: 8px 0 4px;
  font-size: 31px;
  letter-spacing: -.04em;
}
.game-result > strong {
  color: #ff5c57;
  font-size: 20px;
}
.game-result > div {
  margin-top: 22px;
  display: flex;
  gap: 10px;
}
.game-result button,
.game-result a {
  min-height: 47px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  cursor: pointer;
  color: #0c6f64;
  border: 1px solid #bcd5ce;
  border-radius: 11px;
  background: #fff;
  font: inherit;
  font-size: 10px;
  font-weight: 780;
  text-decoration: none;
}
.game-result .daily-game-flow-action {
  color: #fff;
  border-color: #08786d;
  background: #08786d;
}
.game-result .daily-game-flow-action.is-secondary {
  color: #0c6f64;
  background: #fff;
}
.game-result button:disabled {
  cursor: wait;
  opacity: .68;
}
.memory-grid {
  max-width: 820px;
  margin: 42px auto 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr));
  gap: 14px;
}
.memory-grid button {
  min-height: 150px;
  position: relative;
  display: grid;
  place-items: center;
  cursor: pointer;
  color: #fff;
  border: 0;
  border-radius: 18px;
  background: #0b786d;
  box-shadow: 0 12px 22px rgba(9, 95, 83, .13);
  font: inherit;
  transition: transform .2s ease, background-color .2s ease;
}
.memory-grid button:hover {
  transform: translateY(-2px);
}
.memory-grid button.is-revealed {
  color: #163e37;
  border: 1px solid #d4e1db;
  background: #fffaf0;
  transform: rotateY(0);
}
.memory-grid button.is-matched {
  color: #08786d;
  border-color: #95cfc1;
  background: #e4f6f0;
}
.memory-grid button span {
  font-size: 23px;
  font-weight: 760;
}
.memory-grid button.is-revealed span[lang] {
  font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 33px;
}
.memory-grid button svg {
  position: absolute;
  right: 11px;
  top: 11px;
}
.connect-board {
  max-width: 860px;
  margin: 32px auto 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 52px minmax(0, 1fr);
  align-items: center;
  gap: 14px;
}
.connect-board > div:not(.connect-line-column) {
  display: grid;
  gap: 10px;
}
.connect-column-label {
  margin-bottom: 3px;
  color: #80908b;
  font-size: 9px;
  font-weight: 820;
  letter-spacing: .09em;
}
.connect-board button {
  min-height: 66px;
  padding: 0 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  color: #21453e;
  border: 1px solid #dae3de;
  border-radius: 13px;
  background: #fff;
  font: inherit;
}
.connect-board button strong {
  font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 25px;
}
.connect-board button span {
  font-size: 14px;
  font-weight: 680;
}
.connect-board button.is-selected {
  color: #08786d;
  border-color: #08786d;
  background: #eef8f5;
}
.connect-board button.is-matched {
  color: #08786d;
  border-color: #a9d9cd;
  background: #e8f7f2;
}
.connect-board button.is-wrong {
  color: #ba493e;
  border-color: #e9a39c;
  background: #fff0ee;
  animation: writing-input-shake .34s ease both;
}
.connect-line-column {
  display: grid;
  place-items: center;
  color: #a1b3ad;
}
.listen-game-stage,
.write-game-stage,
.quiz-game-stage,
.flash-game-stage {
  padding-inline: clamp(24px, 6vw, 88px);
}
.listen-prompt {
  padding: 42px 20px 24px;
  display: grid;
  justify-items: center;
  text-align: center;
}
.listen-prompt > span,
.write-prompt > span,
.quiz-question > span {
  color: #0b796e;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .11em;
}
.listen-prompt > button {
  width: 78px;
  height: 78px;
  margin-top: 19px;
  display: grid;
  place-items: center;
  cursor: pointer;
  color: #fff;
  border: 0;
  border-radius: 50%;
  background: #08786d;
  box-shadow: 0 15px 30px rgba(8, 120, 109, .2);
}
.listen-prompt h2 {
  margin: 14px 0 3px;
  color: #163e37;
  font-size: 27px;
}
.listen-prompt p {
  margin: 0;
  color: #788782;
  font-size: 10px;
}
.listen-options,
.quiz-options {
  max-width: 780px;
