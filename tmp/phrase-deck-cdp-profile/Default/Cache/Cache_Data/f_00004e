  .listening-banner-shell .himi-section-banner-actions {
    margin-top: 16px;
  }
  .listening-banner-actions {
    display: grid;
    gap: 14px;
  }
  .listening-intro-facts {
    gap: 7px 14px;
  }
  .listening-primary-action {
    width: 100%;
    justify-content: center;
  }
  .listening-section-heading {
    align-items: start;
    flex-direction: column;
    gap: 8px;
  }
  .listening-level-picker {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .listening-level-picker button {
    min-height: 148px;
    padding: 14px;
  }
  .listening-level-symbol {
    width: 42px;
    height: 42px;
  }
  .listening-lesson-grid {
    grid-template-columns: 1fr;
  }
  .listening-lesson-card {
    min-height: 0;
  }
  .listening-session {
    padding: 18px 14px;
  }
  .listening-session-header {
    grid-template-columns: 44px 1fr;
    gap: 12px;
  }
  .listening-score {
    grid-column: 2;
    justify-self: end;
    margin-top: -4px;
    display: flex;
  }
  .listening-score span {
    grid-column: auto;
  }
  .listening-question-stage {
    min-height: 270px;
    padding: 28px 12px 22px;
  }
  .listening-play-button {
    width: 94px;
    height: 94px;
  }
  .listening-audio-control {
    gap: 18px;
    transform: translateX(18px);
  }
  .listening-audio-control > svg {
    width: 28px;
  }
  .listening-choice-grid {
    grid-template-columns: 1fr;
  }
  .listening-choice-grid button {
    min-height: 66px;
  }
  .listening-typing-form > div {
    grid-template-columns: 1fr;
  }
  .listening-typing-form button {
    min-height: 48px;
  }
  .listening-feedback {
    grid-template-columns: 38px 1fr;
  }
  .listening-feedback > button {
    grid-column: 1 / -1;
    justify-content: center;
  }
  .listening-complete-actions {
    flex-direction: column;
  }
  .listening-complete-actions button {
    justify-content: center;
  }
}
@media (prefers-reduced-motion: reduce) {
  .listening-mode-switcher a {
    transition: none;
