  }
  .listening-performance-metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .listening-performance-metrics > div {
    min-height: 58px;
    padding: 4px 8px;
    display: grid;
    align-content: center;
    gap: 3px;
  }
  .listening-performance-metrics > div svg {
    width: 16px;
    height: 16px;
  }
  .listening-performance-metrics strong {
    font-size: .9rem;
  }
  .listening-performance-metrics small {
    font-size: .54rem;
  }
  .listening-banner-shell .himi-section-banner.is-listening {
