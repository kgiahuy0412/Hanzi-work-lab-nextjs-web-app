  color: #fff;
  border: 0;
  border-radius: 10px;
  background: #08786d;
  font: inherit;
  font-size: 10px;
  font-weight: 780;
}
.write-answer-form > span {
  min-height: 31px;
  padding: 8px 3px 0;
