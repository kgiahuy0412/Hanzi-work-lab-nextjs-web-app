@keyframes auth-sheet-rise {
  0% {
    opacity: 0;
    clip-path: inset(42% 36% 42% 36% round 24px);
    transform: translate3d(calc(var(--auth-center-x) + var(--auth-pocket-x)), var(--auth-pocket-y), 0) scale(.2, .12) rotate(-1.2deg);
