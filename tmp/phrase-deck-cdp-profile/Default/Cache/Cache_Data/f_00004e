  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px;
}
.listen-options button,
.quiz-options button {
  min-height: 62px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 11px;
  cursor: pointer;
  color: #284a43;
  border: 1px solid #dbe4df;
  border-radius: 12px;
