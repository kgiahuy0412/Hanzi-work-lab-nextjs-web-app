.course-roadmap-header {
  min-height: 112px;
  padding: 0 4px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  border-bottom: 1px solid #e4e9e5;
}
.course-roadmap-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: #667a74;
  font-size: 13px;
  font-weight: 620;
}
.course-roadmap-header h1 {
  margin: 0;
  color: #10463e;
  font-size: clamp(29px, 3vw, 38px);
  font-weight: 760;
  line-height: 1.12;
  letter-spacing: -.035em;
}
.course-roadmap-progress-row {
  margin-top: 14px;
  display: grid;
  grid-template-columns: auto minmax(150px, 390px) auto;
  align-items: center;
  gap: 18px;
  color: #405a54;
}
.course-roadmap-progress-row strong {
  font-size: 14px;
  font-weight: 720;
}
.course-roadmap-progress-row small {
  color: #6f817c;
  font-size: 11px;
  font-weight: 720;
}
.course-roadmap-progress-track {
  height: 7px;
  overflow: hidden;
  border-radius: 999px;
  background: #e7ebe8;
}
.course-roadmap-progress-track > span {
  height: 100%;
  display: block;
  border-radius: inherit;
  background: #08796d;
  transition: width .3s ease;
}
.course-roadmap-switch {
  min-height: 44px;
  padding: 0 8px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #08786d;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}
.course-roadmap-switch:hover {
  color: #065d55;
}
.course-roadmap-layout {
  padding-top: 20px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 294px;
  align-items: start;
  gap: 34px;
}
.course-roadmap-stages {
  min-width: 0;
  display: grid;
  gap: 18px;
}
.roadmap-stage {
  min-width: 0;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  position: relative;
}
.roadmap-stage-rail {
  min-height: 86px;
  position: relative;
  display: flex;
  justify-content: center;
}
.roadmap-stage:not(:last-child) .roadmap-stage-rail::after {
  content: "";
  width: 2px;
  position: absolute;
  top: 53px;
  bottom: -29px;
  border-radius: 2px;
  background: #d8dfdb;
}
.roadmap-stage.is-completed:not(:last-child) .roadmap-stage-rail::after,
.roadmap-stage.is-active:not(:last-child) .roadmap-stage-rail::after {
  background: #8bc7ba;
}
.roadmap-stage-marker {
  width: 46px;
  height: 46px;
  margin-top: 12px;
  z-index: 1;
  display: grid;
  place-items: center;
  color: #60716c;
  border-radius: 50%;
  background: #e8ebe9;
  box-shadow: 0 3px 8px rgba(20, 65, 57, .09);
  font-size: 20px;
  font-weight: 760;
}
.roadmap-stage-marker.is-completed,
.roadmap-stage-marker.is-active {
  color: #fff;
  background: #0a7468;
}
.roadmap-stage-marker.is-active {
  box-shadow: 0 0 0 5px #edf7f3, 0 4px 10px rgba(8, 100, 88, .2);
}
.roadmap-stage-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #dfe5e1;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 2px 7px rgba(23, 60, 53, .035);
}
details.roadmap-stage-card > summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 30px;
  align-items: center;
  cursor: pointer;
  list-style: none;
}
details.roadmap-stage-card > summary::-webkit-details-marker {
  display: none;
}
details.roadmap-stage-card > summary:focus-visible {
  outline-offset: -4px;
}
.roadmap-stage.is-active .roadmap-stage-card {
  border-color: #91c9bd;
  box-shadow: 0 6px 20px rgba(35, 101, 88, .07);
}
.roadmap-stage.is-locked .roadmap-stage-card {
  color: #73817d;
  background: rgba(255,255,255,.72);
}
.roadmap-stage-summary {
  min-height: 84px;
  display: grid;
  grid-template-columns: 176px minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px;
}
.roadmap-stage-image {
  width: 176px;
  height: 84px;
  position: relative;
  overflow: hidden;
  background: #e9f0ec;
}
.roadmap-stage-image img {
  object-fit: cover;
}
.roadmap-stage.is-locked .roadmap-stage-image img {
  filter: saturate(.55);
  opacity: .78;
}
.roadmap-stage-copy {
  min-width: 0;
  padding-block: 13px;
}
.roadmap-stage-copy h2 {
  margin: 0;
  overflow: hidden;
  color: #183f38;
  font-size: 18px;
  font-weight: 720;
  line-height: 1.25;
  letter-spacing: -.018em;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.roadmap-stage-copy p {
  margin: 6px 0 0;
  color: #6a7b76;
  font-size: 12px;
}
.roadmap-stage-status {
  min-height: 31px;
  margin-right: 16px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.roadmap-stage-status.is-completed {
  color: #488276;
  border-color: #d8ebe5;
  background: #eff7f4;
}
.roadmap-stage-status.is-active {
  color: #08796d;
  background: #e4f4ef;
}
.roadmap-stage-status.is-vip {
  color: #8b5f1d;
  border-color: #f2d59e;
  background: #fff7e8;
}
.roadmap-stage-status.is-locked {
  color: #707a77;
  border-color: #e1e4e2;
  background: #f5f6f5;
}
.roadmap-stage-expand {
  color: #6f817c;
  transition: transform .2s ease;
}
details[open].roadmap-stage-card .roadmap-stage-expand {
  transform: rotate(90deg);
}
.roadmap-lesson-list {
  margin: 0 12px 12px;
  overflow: hidden;
  border: 1px solid #e2e7e4;
  border-radius: 9px;
  background: #fff;
}
.roadmap-lesson-row {
  min-height: 51px;
  padding: 0 16px;
  display: grid;
  grid-template-columns: 25px minmax(0, 1fr) 72px minmax(0, 165px) 19px;
  align-items: center;
  gap: 10px;
  color: #556660;
  border-bottom: 1px solid #e6e9e7;
  font-size: 12px;
}
.roadmap-lesson-row:last-child {
  border-bottom: 0;
}
a.roadmap-lesson-row {
  transition: color .18s ease, background .18s ease;
}
a.roadmap-lesson-row:hover {
  color: #0b665c;
  background: #f5faf8;
}
.roadmap-lesson-state {
  width: 19px;
  height: 19px;
  display: grid;
  place-items: center;
  color: #75827e;
  border-radius: 50%;
}
.roadmap-lesson-row.is-completed .roadmap-lesson-state {
  color: #fff;
  background: #36aa50;
}
.roadmap-lesson-row.is-current {
  min-height: 57px;
  color: #0a7066;
  background: #eaf7f3;
}
.roadmap-lesson-row.is-current .roadmap-lesson-state {
  color: #08796d;
}
.roadmap-lesson-row.is-current .roadmap-lesson-state svg {
  stroke-width: 2.4;
}
.roadmap-lesson-row.is-vip-locked {
  color: #77684c;
  background: #fffaf0;
}
.roadmap-lesson-row.is-vip-locked .roadmap-lesson-state {
  color: #ad7b28;
}
.roadmap-lesson-row.is-locked {
  color: #78837f;
  background: #fcfcfb;
}
.roadmap-lesson-copy {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.roadmap-lesson-copy > span {
  color: #64746f;
  white-space: nowrap;
}
.roadmap-lesson-copy > i {
  color: #9ca7a3;
  font-style: normal;
}
.roadmap-lesson-copy > strong {
  min-width: 0;
  overflow: hidden;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.roadmap-lesson-row.is-current .roadmap-lesson-copy > strong {
  color: #076d63;
  font-weight: 740;
}
.roadmap-lesson-minutes {
  color: #697974;
  text-align: right;
  white-space: nowrap;
}
.roadmap-lesson-cta {
  min-height: 40px;
  padding: 0 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 9px;
  background: #08796d;
  font-size: 12px;
  font-weight: 760;
  white-space: nowrap;
  box-shadow: 0 6px 15px rgba(8, 109, 97, .16);
}
.roadmap-lesson-cta:hover {
  background: #065f57;
}
.roadmap-lesson-vip {
  min-height: 36px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #8d611e;
  border: 1px solid #edcf98;
  border-radius: 9px;
  background: #fff;
  font-size: 11px;
  font-weight: 760;
  white-space: nowrap;
}
.roadmap-lesson-chevron {
  color: #78908a;
}
.course-roadmap-aside {
  min-width: 0;
  position: sticky;
  top: 100px;
  display: grid;
  gap: 24px;
}
.course-roadmap-overview {
  padding: 22px 24px 12px;
  border: 1px solid #dfe5e1;
  border-radius: 16px;
  background: rgba(255,255,255,.86);
  box-shadow: 0 5px 18px rgba(31, 71, 63, .04);
}
.course-roadmap-overview h2 {
  margin: 0 0 12px;
  color: #183f38;
  font-size: 19px;
  font-weight: 720;
}
.roadmap-overview-stat {
  min-height: 85px;
  display: grid;
  grid-template-columns: 38px 1fr;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid #e4e8e5;
}
.roadmap-overview-stat:last-of-type {
  border-bottom: 0;
}
.roadmap-overview-stat > span {
  color: #5f6f6b;
}
.roadmap-overview-stat p {
  margin: 0;
  display: grid;
  gap: 4px;
  color: #6d7c78;
  font-size: 12px;
  line-height: 1.35;
}
.roadmap-overview-stat strong {
  color: #263f3a;
  font-size: 15px;
  font-weight: 740;
}
.roadmap-signin-note {
  min-height: 43px;
  margin-top: 3px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: #08796d;
  border-top: 1px solid #e4e8e5;
  font-size: 11px;
  font-weight: 720;
}
.course-roadmap-coach {
  min-height: 198px;
  display: grid;
  grid-template-columns: 118px minmax(0, 1fr);
  align-items: end;
  position: relative;
}
.course-roadmap-coach-image {
  width: 148px;
  height: 148px;
  margin-left: -15px;
  z-index: 1;
  object-fit: contain;
}
.course-roadmap-coach-bubble {
  min-height: 100px;
  margin: 0 0 12px -3px;
  padding: 20px 17px 16px;
  position: relative;
  color: #3d4b47;
  border: 1px solid #f1ce78;
  border-radius: 13px;
  background: #fffaf0;
  box-shadow: 0 7px 20px rgba(104, 78, 24, .06);
}
.course-roadmap-coach-bubble::before {
  content: "";
  width: 12px;
  height: 12px;
  position: absolute;
  top: 40px;
  left: -7px;
  border-bottom: 1px solid #f1ce78;
  border-left: 1px solid #f1ce78;
  background: #fffaf0;
  transform: rotate(45deg);
}
.course-roadmap-coach-bubble > svg {
  position: absolute;
  top: -33px;
  left: -20px;
  color: #ffad19;
}
.course-roadmap-coach-bubble p {
  margin: 0;
  font-size: 13px;
  font-weight: 620;
  line-height: 1.55;
}
.course-roadmap-coach-bubble a {
  margin-top: 9px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: #9b6819;
  font-size: 11px;
  font-weight: 760;
}
@media (max-width: 1060px) {
  .course-roadmap-layout {
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 22px;
  }
  .roadmap-stage-summary {
    grid-template-columns: 145px minmax(0, 1fr) auto;
    gap: 15px;
  }
  .roadmap-stage-image {
    width: 145px;
  }
  .roadmap-lesson-row {
    grid-template-columns: 25px minmax(0, 1fr) 64px minmax(0, 140px) 19px;
    padding-inline: 12px;
    gap: 8px;
  }
  .roadmap-lesson-cta {
    padding-inline: 12px;
  }
}
@media (max-width: 900px) {
  .course-roadmap-layout {
    grid-template-columns: 1fr;
  }
  .course-roadmap-aside {
    position: static;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .85fr);
  }
  .course-roadmap-coach {
    min-height: 170px;
  }
}
@media (max-width: 720px) {
  .course-roadmap-page {
    min-height: 0;
    padding: max(12px, env(safe-area-inset-top)) env(safe-area-inset-right) calc(104px + env(safe-area-inset-bottom)) env(safe-area-inset-left);
    overflow-x: clip;
  }
  .course-roadmap-shell {
    width: min(calc(100% - 24px), 640px);
  }
  .course-roadmap-header {
    min-height: 0;
    padding: 0 0 18px;
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }
  .course-roadmap-header > div {
    width: 100%;
    min-width: 0;
  }
  .course-roadmap-header h1 {
    font-size: clamp(24px, 7vw, 28px);
    overflow-wrap: anywhere;
  }
  .course-roadmap-progress-row {
    width: 100%;
    margin-top: 14px;
    grid-template-columns: auto minmax(72px, 1fr) auto;
    gap: 10px;
  }
  .course-roadmap-progress-track {
    min-width: 0;
  }
  .course-roadmap-switch {
    min-height: 44px;
    padding: 0 4px;
  }
  .course-roadmap-layout {
    padding-top: 18px;
    gap: 18px;
  }
  .course-roadmap-stages {
    gap: 14px;
  }
  .roadmap-stage {
    grid-template-columns: 36px minmax(0, 1fr);
  }
  .roadmap-stage-marker {
    width: 32px;
    height: 32px;
    margin-top: 18px;
    font-size: 14px;
  }
  .roadmap-stage-marker svg {
    width: 17px;
    height: 17px;
  }
  .roadmap-stage:not(:last-child) .roadmap-stage-rail::after {
    top: 53px;
    bottom: -27px;
  }
  .roadmap-stage-card {
    border-radius: 14px;
  }
  .roadmap-stage-summary {
    min-height: 94px;
    grid-template-columns: clamp(92px, 26vw, 112px) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(10px, 3vw, 13px);
  }
  .roadmap-stage-image {
    width: 100%;
    height: 100%;
    min-height: 94px;
    grid-row: 1 / span 2;
  }
  .roadmap-stage-copy {
    align-self: end;
    padding: 12px 8px 3px 0;
  }
  .roadmap-stage-copy h2 {
    font-size: 15px;
    line-height: 1.32;
    white-space: normal;
  }
  .roadmap-stage-copy p {
    margin-top: 4px;
    font-size: 10px;
    line-height: 1.4;
  }
  .roadmap-stage-status {
    min-height: 28px;
    width: fit-content;
    margin: 0 8px 9px 0;
    padding: 0 9px;
    align-self: start;
    grid-column: 2;
    font-size: 9.5px;
  }
  details.roadmap-stage-card > summary {
    min-height: 44px;
    grid-template-columns: minmax(0, 1fr) 28px;
  }
  .roadmap-stage-expand {
    width: 18px;
    height: 18px;
  }
  .roadmap-lesson-list {
    margin: 0 8px 8px;
    border-radius: 10px;
  }
  .roadmap-lesson-row {
    min-height: 68px;
    padding: 11px 12px;
    grid-template-columns: 24px minmax(0, 1fr) 20px;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 3px 8px;
    font-size: 12px;
  }
  .roadmap-lesson-state {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .roadmap-lesson-copy {
    grid-column: 2;
    grid-row: 1;
    flex-wrap: wrap;
    gap: 3px 5px;
  }
  .roadmap-lesson-copy > span {
    font-size: 10px;
    font-weight: 680;
  }
  .roadmap-lesson-copy > strong {
    width: 100%;
    flex-basis: 100%;
    font-size: 13px;
    line-height: 1.35;
    white-space: normal;
  }
  .roadmap-lesson-copy > i {
    display: none;
  }
  .roadmap-lesson-minutes {
    grid-column: 2;
    grid-row: 2;
    text-align: left;
    font-size: 10.5px;
  }
  .roadmap-lesson-cta,
  .roadmap-lesson-vip {
    min-height: 44px;
    width: 100%;
    margin-top: 6px;
    padding-inline: 12px;
    grid-column: 2 / 4;
    grid-row: 3;
    justify-self: stretch;
  }
  .roadmap-lesson-chevron {
    grid-column: 3;
    grid-row: 1 / span 2;
  }
  .roadmap-lesson-row.is-current,
  .roadmap-lesson-row.is-vip-locked {
    grid-template-rows: auto auto auto;
  }
  .course-roadmap-aside {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .course-roadmap-overview {
    padding: 18px 18px 8px;
    border-radius: 14px;
  }
  .roadmap-overview-stat {
    min-height: 72px;
  }
  .course-roadmap-coach {
    width: min(360px, 100%);
    margin-inline: auto;
  }
  .course-roadmap-coach-bubble > svg {
    top: -25px;
    left: 8px;
  }
}
@media (max-width: 720px) and (max-height: 500px) and (orientation: landscape) {
  .course-roadmap-page {
    padding-top: max(8px, env(safe-area-inset-top));
  }
  .course-roadmap-header {
    padding-bottom: 12px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  .course-roadmap-header > div {
    grid-column: 1;
    grid-row: 1;
  }
  .course-roadmap-eyebrow {
    margin-bottom: 3px;
  }
  .course-roadmap-header h1 {
    font-size: 24px;
  }
  .course-roadmap-progress-row {
    margin-top: 8px;
  }
  .course-roadmap-switch {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
  }
  .course-roadmap-layout {
    padding-top: 12px;
  }
}
@media (max-width: 430px) {
  .course-roadmap-shell {
    width: calc(100% - 16px);
  }
  .course-roadmap-eyebrow {
    margin-bottom: 5px;
    font-size: 11px;
  }
  .course-roadmap-header h1 {
    font-size: clamp(23px, 7.2vw, 26px);
    line-height: 1.18;
  }
  .course-roadmap-progress-row strong {
    font-size: 12px;
  }
  .course-roadmap-progress-row small {
    font-size: 10px;
  }
  .roadmap-stage {
    grid-template-columns: 30px minmax(0, 1fr);
  }
  .roadmap-stage-marker {
    width: 28px;
    height: 28px;
    margin-top: 20px;
    font-size: 12px;
  }
  .roadmap-stage-summary {
    min-height: 90px;
    grid-template-columns: clamp(76px, 23vw, 88px) minmax(0, 1fr);
    gap: 9px;
  }
  .roadmap-stage-image {
    min-height: 90px;
  }
  .roadmap-stage-copy {
    padding-right: 5px;
  }
  .roadmap-stage-copy h2 {
    font-size: 14px;
  }
  .roadmap-stage-status {
    margin-right: 5px;
    padding-inline: 7px;
  }
  .roadmap-lesson-list {
    margin: 0 6px 6px;
  }
  .roadmap-lesson-row {
    padding: 10px;
    grid-template-columns: 22px minmax(0, 1fr) 18px;
    gap-inline: 7px;
  }
  .roadmap-lesson-cta,
  .roadmap-lesson-vip {
    grid-column: 1 / -1;
  }
  .course-roadmap-overview {
    padding-inline: 16px;
  }
  .course-roadmap-coach {
    grid-template-columns: 90px minmax(0, 1fr);
  }
  .course-roadmap-coach-image {
    width: 114px;
    height: 114px;
    margin-left: -12px;
  }
  .course-roadmap-coach-bubble {
    min-height: 92px;
    padding: 17px 13px 14px;
  }
}
@media (max-width: 350px) {
  .course-roadmap-shell {
    width: calc(100% - 12px);
  }
  .course-roadmap-header h1 {
    font-size: 23px;
  }
  .course-roadmap-progress-row {
    gap: 8px;
  }
  .roadmap-stage {
    grid-template-columns: 27px minmax(0, 1fr);
  }
  .roadmap-stage-marker {
    width: 25px;
    height: 25px;
    font-size: 11px;
  }
  .roadmap-stage-summary {
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 8px;
  }
  .roadmap-stage-status {
    font-size: 9px;
  }
  .roadmap-stage-status svg {
    display: none;
  }
  .roadmap-lesson-list {
