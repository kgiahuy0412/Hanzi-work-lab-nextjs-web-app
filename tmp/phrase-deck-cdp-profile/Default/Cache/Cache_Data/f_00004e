@keyframes hw-route-progress {
  0% {
    transform: scaleX(.025);
  }
  48% {
    transform: scaleX(.64);
  }
  76% {
    transform: scaleX(.79);
  }
  100% {
    transform: scaleX(.9);
  }
}
.route-transition-progress {
  position: fixed;
  top: 0;
  right: 0;
  left: 100px;
  z-index: 2147483647;
  height: 4px;
  overflow: hidden;
  pointer-events: none;
  opacity: 0;
  background: rgba(255, 91, 85, .1);
  transition: opacity 160ms ease;
}
.route-transition-progress span {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #ff8178 0%, #ff5b55 58%, #e83f49 100%);
  box-shadow: 0 0 12px rgba(255, 91, 85, .42);
  transform: scaleX(.025);
  transform-origin: left center;
  transition: transform 420ms cubic-bezier(.22, 1, .36, 1);
}
.route-transition-progress.active,
.route-transition-progress.complete {
  opacity: 1;
}
.route-transition-progress.active span {
  animation: hw-route-progress 2400ms cubic-bezier(.16, .78, .22, 1) forwards;
}
.route-transition-progress.complete span {
  animation: none;
  transform: scaleX(1);
}
