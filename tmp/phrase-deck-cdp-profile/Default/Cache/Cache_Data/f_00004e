:root {
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --control-min: 44px;
  --focus-color: #08786d;
  --focus-halo: rgba(8, 120, 109, .2);
  --text-muted: #536a64;
}
html {
  scroll-padding-top: 104px;
  scrollbar-color: #a9c9c0 #f3f5f1;
  scrollbar-width: thin;
}
body {
  min-width: 320px;
  text-rendering: optimizeLegibility;
}
button,
input,
select,
textarea {
  font: inherit;
}
button:not(:disabled),
a[href],
summary {
  touch-action: manipulation;
}
button:not(:disabled),
summary {
  cursor: pointer;
}
input,
select,
textarea {
  caret-color: var(--forest);
}
::placeholder {
  color: #71817c;
  opacity: 1;
}
:where(a[href], button, input, select, textarea, summary):focus-visible {
  outline: 3px solid var(--focus-color);
  outline-offset: 3px;
  box-shadow: 0 0 0 5px var(--focus-halo);
}
:where(button, input, select, textarea):disabled,
[aria-disabled="true"] {
  cursor: not-allowed;
  opacity: .62;
}
[aria-busy="true"] {
  cursor: progress;
}
.skip-link {
  position: fixed;
  z-index: 200;
  top: 12px;
  left: 116px;
  min-height: var(--control-min);
  padding: 0 16px;
  display: inline-flex;
  align-items: center;
  color: #fff;
  border-radius: 12px;
  background: var(--forest-deep);
  box-shadow: 0 12px 28px rgba(8, 72, 62, .22);
  font-size: 14px;
  font-weight: 780;
  transform: translateY(calc(-100% - 18px));
  transition: transform 160ms cubic-bezier(.22, 1, .36, 1);
}
.skip-link:focus-visible {
  outline-color: #fff;
  box-shadow: 0 0 0 4px var(--focus-color), 0 12px 28px rgba(8, 72, 62, .22);
  transform: translateY(0);
}
