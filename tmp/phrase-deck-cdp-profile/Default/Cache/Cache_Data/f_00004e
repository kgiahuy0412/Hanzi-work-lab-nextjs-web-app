@keyframes writing-penguin-strike {
  0% {
    opacity: 1;
    filter: drop-shadow(0 17px 18px rgba(35, 75, 47, .14));
    transform: translate3d(0, 0, 0) rotate(-4deg) scale(1);
  }
  16% {
    opacity: 1;
    transform: translate3d(-24px, 17px, 0) rotate(-10deg) scale(1.03);
  }
  54% {
    opacity: 1;
    filter: drop-shadow(-18px 19px 11px rgba(35, 75, 47, .11));
    transform: translate3d(var(--strike-approach-x), var(--strike-approach-y), 0) rotate(3deg) scale(.95);
  }
  64% {
    opacity: 1;
    filter: drop-shadow(-24px 22px 9px rgba(35, 75, 47, .08));
    transform: translate3d(var(--strike-impact-x), var(--strike-impact-y), 0) rotate(11deg) scale(.92);
  }
  71% {
    opacity: 1;
    filter: drop-shadow(-24px 22px 9px rgba(35, 75, 47, .08));
    transform: translate3d(var(--strike-impact-x), var(--strike-impact-y), 0) rotate(11deg) scale(.92);
  }
  100% {
    opacity: 0;
    filter: drop-shadow(-30px 25px 6px rgba(35, 75, 47, 0));
    transform: translate3d(var(--strike-exit-x), var(--strike-exit-y), 0) rotate(19deg) scale(.78);
  }
}
@keyframes writing-penguin-cape-flutter {
  0%, 9% {
    opacity: 0;
    transform: rotate(3deg) skewY(-2deg) scaleX(.34);
  }
  16% {
    opacity: .72;
    transform: rotate(6deg) skewY(-5deg) scaleX(.72);
  }
  24% {
    opacity: 1;
    transform: rotate(2deg) skewY(-3deg) scaleX(.98);
  }
  52% {
    opacity: 1;
    transform: rotate(-5deg) skewY(5deg) scaleX(1.08);
  }
  64% {
    opacity: 1;
    transform: rotate(7deg) skewY(-6deg) scaleX(.94);
  }
  76% {
    opacity: 1;
    transform: rotate(-3deg) skewY(4deg) scaleX(1.05);
  }
  92% {
    opacity: .9;
    transform: rotate(-1deg) skewY(2deg) scaleX(1.02);
  }
  100% {
    opacity: 0;
    transform: rotate(-4deg) skewY(3deg) scaleX(.86);
  }
}
@keyframes writing-slice-impact {
  0%, 55% {
    opacity: 0;
    transform: translate3d(-50%, -50%, 0) scale(.42) rotate(-7deg);
  }
  64% {
    opacity: 1;
    transform: translate3d(-50%, -50%, 0) scale(.9) rotate(-2deg);
  }
  72% {
    opacity: .96;
    transform: translate3d(-50%, -50%, 0) scale(1.02) rotate(0);
  }
  100% {
