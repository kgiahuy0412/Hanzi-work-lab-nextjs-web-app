DATABASE_URL=postgresql://hanziwork:hanziwork@localhost:5432/hanziwork
AUTH_SECRET=replace-with-a-long-random-secret
SEPAY_API_KEY=
# Khuyến nghị: cấu hình webhook SePay bằng HMAC-SHA256 và dùng cùng secret ở đây.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=ACB
SEPAY_BANK_ACCOUNT_NUMBER=12897891
SEPAY_BANK_ACCOUNT_NAME=LE CHAU KIET
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tên biến cũ vẫn được hỗ trợ làm fallback cho cấu hình tài khoản thanh toán.
VIP_BANK_NAME=
VIP_BANK_ACCOUNT_NUMBER=
VIP_BANK_ACCOUNT_NAME=
# URL HTTPS của Worker staging, ví dụ https://hanziwork-staging.<account>.workers.dev
STAGING_APP_URL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=hello@example.com
BREVO_FROM_NAME=Himi Chinese
AUTH_TRUST_X_FORWARDED_FOR=0
AUTH_TRUST_CF_CONNECTING_IP=0
# Chỉ dùng 0 khi chạy production build qua HTTP trên máy local; production thật nên để trống hoặc 1.
AUTH_COOKIE_SECURE=
CLOUDINARY_URL=

# iFlytek Pronunciation Assessment (streaming, Global). Lấy tại console-global.xfyun.cn.
# Chỉ đặt ở server; không đổi thành biến NEXT_PUBLIC_*.
IFLYTEK_ISE_APP_ID=
IFLYTEK_ISE_API_KEY=
IFLYTEK_ISE_API_SECRET=
